# ==== باشگاه۳۶۰ — environment template (TECH-06) ====
# کپی به .env و مقادیر واقعی را از مدیریت Secrets خارج از ریپو بدهید (SEC-01).

APP_ENV=development              # development | test | production
SECRET_KEY=change-me-32-bytes-random
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/club360_dev
REDIS_URL=redis://redis:6379/0   # خالی = اجرای درون‌فرآیندی (فقط توسعه)

# --- Security flags (must be ON in production) ---
COOKIE_SECURE=false              # true پشت TLS
REQUIRE_MFA=false                # در عملیات واقعی برای نقش‌های حساس true (ACC-14)
REQUIRE_POLICY_SIGNOFF=false     # در عملیات واقعی true (CFG-03)
ENABLE_SIMULATORS=true           # در عملیات واقعی false (ARC-05)

# --- S360 identity (open question Q1) ---
S360_OIDC_ISSUER=
S360_OIDC_CLIENT_ID=
S360_OIDC_CLIENT_SECRET=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Tunables (demo defaults; real values need university policy approval — Q3) ---
DEFAULT_RESERVATION_TTL_MINUTES=30
K_ANONYMITY_THRESHOLD=5
RATE_LIMIT_PER_MINUTE=240

# --- Frontend ---
VITE_API_TARGET=http://127.0.0.1:8000

# --- Smart assistant (v1.6) ---
# آدرس هستهٔ عامل «دانشگاه هوشمند من» — مغز دستیار هوشمند دانشجو که در تمامی
# سامانه‌های اکوسیستم دانشجو۳۶۰ با ویجت پایین‌چپ نمایان می‌شود.
# خالی = مبدأ فعلی (در استقرار واقعی آدرس هسته را ست کنید؛ مثل: http://188.212.96.235:PORT)
VITE_MSU_AGENT_URL=
