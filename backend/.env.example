# باشگاه دانشجو۳۶۰ — نمونهٔ پیکربندی (docker-compose / استقرار عملیاتی)
# در استقرار عملیاتی مقدارهای واقعی بگذارید و فایل را نسازید جز با مجوز مدیر فنی.

ENVIRONMENT=production
SECRET_KEY=change-me-32-bytes-random
CORS_ORIGINS=http://188.212.96.235:8089,http://localhost:8089
COOKIE_SECURE=false            # پشت TLS: true
REQUIRE_MFA=true               # ACC-14 — برای استقرار عملیاتی الزامی
REQUIRE_POLICY_SIGNOFF=true    # CFG-03

# PostgreSQL (مرجع رسمی امتیاز/ظرفیت) + Redis/Celery
DATABASE_URL=postgresql://club360:change-me@db:5432/club360
REDIS_URL=redis://redis:6379/0

# ---- ورود یکپارچه با سامانهٔ مرکزی دانشجو۳۶۰ (SSO/OIDC) ----
SSO_ISSUER=http://188.212.96.235:8086
SSO_CLIENT_ID=club360
SSO_CLIENT_SECRET=change-me-if-required
SSO_SCOPES=openid profile email
# اگر سرور پشت پروکسی است و Host واقعی نمی‌رسد، صریح بدهید:
# SSO_REDIRECT_URI=http://188.212.96.235:8089/api/v1/auth/sso/callback
SSO_DEFAULT_ROLE=student
SSO_DEFAULT_UNIVERSITY_CODE=UNI-A
